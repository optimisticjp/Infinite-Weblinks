{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "npm run lint -- --quiet" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "npm run typecheck && npm run test" }]
      }
    ]
  }
}

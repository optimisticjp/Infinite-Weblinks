# Infinite Weblinks — example environment (NAMES + PLACEHOLDERS ONLY, never real secrets)
# Copy to .env.local (git-ignored) and fill with your own values.
# See docs/operations/cloudflare-production-readiness.md for the production inventory + owner checks.

# --- Sanity CMS (public, build-time) ---
# Project ID and dataset are PUBLIC identifiers (they ship in the client bundle), not secrets.
# These are the live Infinite Weblinks project — copy as-is for local dev; production reads them
# from the Cloudflare build variables.
NEXT_PUBLIC_SANITY_PROJECT_ID=ay705p7x
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# Release-safety switch for reading LIVE CMS content. Default `false`: the public site renders the
# reviewed seed content and issues NO Sanity queries (the Studio/dataset stay live but unused by the
# site). Set to exactly `true` ONLY after a controlled preview verification to serve live CMS reads.
NEXT_PUBLIC_SANITY_LIVE_CONTENT_ENABLED=false

# --- Sanity (server-only secrets — for Draft Mode / preview; added in later milestones) ---
# SANITY_API_READ_TOKEN=changeme-viewer-scoped-token
# SANITY_REVALIDATE_SECRET=changeme-webhook-shared-secret
# SANITY_PREVIEW_SECRET=changeme-draft-mode-secret

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare Web Analytics (public beacon; wired via <Analytics/>, off until set) ---
# NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=changeme-analytics-beacon-token

# --- Google Search Console (site-ownership meta tag; off until set) ---
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=changeme-search-console-verification-token

# --- Turnstile (Cloudflare) ---
# Public SITE key (ships in the client bundle — public by design). Absent ⇒ the widget doesn't render.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=changeme-turnstile-site-key
# SERVER-ONLY secret (never NEXT_PUBLIC_). Required in production/preview — missing ⇒ forms fail closed.
# TURNSTILE_SECRET_KEY=changeme-turnstile-secret-key
# Optional extra hostnames a Turnstile response's hostname may match (comma-separated). Hostname
# enforcement is ACTIVE whenever a canonical host can be derived from NEXT_PUBLIC_SITE_URL, OR extra
# hosts are listed here (the canonical host is always allowed); it is skipped ONLY when neither yields
# a host. When enforcement is active, a missing or unlisted response hostname fails closed.
# TURNSTILE_ALLOWED_HOSTNAMES=preview.infiniteweblinks.com

# --- Formspree (SERVER-ONLY email transport — NOT NEXT_PUBLIC_, so ids never ship to the browser) ---
# FORMSPREE_GROWTH_PLAN_ID=your-growth-plan-form-id
# FORMSPREE_CONTACT_ID=your-contact-form-id

# --- Deployment environment policy (server-only) ---
# APP_ENV distinguishes preview vs production (both build as NODE_ENV=production). One of:
#   development | test | preview | production. Unset/unrecognised ⇒ treated as production (fail-closed).
# APP_ENV=production
# DEV/TEST ONLY explicit opt-in to bypass Turnstile + the CF rate limiter when unconfigured locally.
# IGNORED in production/preview. NEVER set this in a deployed environment.
# FORMS_ALLOW_INSECURE_BYPASS=true

# --- Cloudflare deploy (CI only — NOT read by the running app) ---
# CLOUDFLARE_ACCOUNT_ID=changeme-account-id
# CLOUDFLARE_API_TOKEN=changeme-deploy-token

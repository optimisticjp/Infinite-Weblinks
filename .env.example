# Infinite Weblinks — example environment (NAMES + PLACEHOLDERS ONLY, never real secrets)
# Copy to .env.local (git-ignored) and fill with your own values.
# See specs/001-infinite-weblinks-website/design/environment.md for the full inventory.

# --- Sanity CMS (public, build-time) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# --- Sanity (server-only secrets — for Draft Mode / preview; added in later milestones) ---
# SANITY_API_READ_TOKEN=changeme-viewer-scoped-token
# SANITY_REVALIDATE_SECRET=changeme-webhook-shared-secret
# SANITY_PREVIEW_SECRET=changeme-draft-mode-secret

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare Web Analytics (public beacon; wired via <Analytics/>, off until set) ---
# NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=changeme-analytics-beacon-token

# --- Google Search Console (site-ownership meta tag; off until set) ---
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=changeme-search-console-verification-token

# --- Formspree + Turnstile (added in the forms milestone, M6 — not used in M2–M4) ---
# NEXT_PUBLIC_FORMSPREE_GROWTH_PLAN_ID=your-growth-plan-form-id
# NEXT_PUBLIC_FORMSPREE_CONTACT_ID=your-contact-form-id
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=changeme-turnstile-site-key
# TURNSTILE_SECRET_KEY=changeme-turnstile-secret-key

# --- Cloudflare deploy (CI only — NOT read by the running app) ---
# CLOUDFLARE_ACCOUNT_ID=changeme-account-id
# CLOUDFLARE_API_TOKEN=changeme-deploy-token

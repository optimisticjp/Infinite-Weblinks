# dependencies
node_modules/
studio/node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# OpenNext / Cloudflare
.open-next/
.wrangler/
.dev.vars
wrangler.*.local

# env / secrets — NEVER commit real values
.env
.env.*
!.env.example
studio/.env
studio/.env.*
!studio/.env.example

# testing / reports
coverage/
playwright-report/
test-results/
/artifacts/
lighthouse-*.json
lighthouse-*.html

# Scratch screenshot output — the default `npm run screenshots` target. Regenerable;
# ignored so nobody commits ~80MB of PNGs by accident. baseline/ and phase-N/ stay tracked.
review-artifacts/screenshots/*
!review-artifacts/screenshots/.gitkeep

# sanity
studio/dist/
.sanity/

# misc
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/

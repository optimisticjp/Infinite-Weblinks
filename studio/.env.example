# Sanity Studio environment — copy this file to `studio/.env` (git-ignored) and fill in real
# values. Never commit a real project ID/dataset combination beyond what is already public, and
# never add a secret value to this file or to `studio/.env`.
#
# These values MUST match the site's NEXT_PUBLIC_SANITY_PROJECT_ID / NEXT_PUBLIC_SANITY_DATASET
# (see /specs/001-infinite-weblinks-website/design/environment.md §2) — the Studio and the Next.js
# app read the same Sanity project/dataset, they are just two separate deployments of the tooling
# around it.

# Public identifiers (not secrets) — the live Infinite Weblinks project. Must match the site's
# NEXT_PUBLIC_SANITY_PROJECT_ID / NEXT_PUBLIC_SANITY_DATASET.
SANITY_STUDIO_PROJECT_ID=ay705p7x
SANITY_STUDIO_DATASET=production

# Optional — pins the hosted Studio subdomain (https://<value>.sanity.studio) so `sanity deploy`
# does not prompt interactively (useful for CI). The hosted studio name is otherwise chosen once,
# interactively, on the very first `sanity deploy` and then stays fixed for the project's lifetime.
# SANITY_STUDIO_HOST=infinite-weblinks

# --- App release-safety flag (consumed by the Next.js site, NOT the Studio) ---
# Listed here for a complete project env picture; set it on the SITE build, not the Studio. Default
# `false` keeps the public site on reviewed seed content; `true` enables live CMS reads.
NEXT_PUBLIC_SANITY_LIVE_CONTENT_ENABLED=false

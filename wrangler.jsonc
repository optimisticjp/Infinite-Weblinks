{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infinite-weblinks",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Incremental cache — R2 (owner decision: R2, not KV).
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "iw-inc-cache" }],
  // Tag cache — D1 (drives on-demand revalidateTag/revalidatePath).
  // database_id is a placeholder for local emulation; replace with the real D1 id at deploy.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "iw-tag-cache",
      "database_id": "29042ec8-77c6-4185-9d82-9f3936975b5f"
    }
  ],
  // Form abuse guard — Cloudflare-native Rate Limiting rule, consistent across
  // isolates/regions. src/lib/forms/rate-limit-adapter.ts binds this automatically; when it
  // is absent (local dev, unit tests) the adapter falls back to the in-memory limiter.
  // 5 submissions / 60s per key (IP+form). namespace_id is an account-unique rule id.
  "ratelimits": [{ "name": "FORM_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
  // NOTE: no kv_namespaces — Workers KV is intentionally not the incremental cache.
}
